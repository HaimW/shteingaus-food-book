---
// Prominent "בנה לי ארוחה" / "מתכון אקראי" buttons (build-plan R5, R6).
// With `meal`, both links carry that meal filter (meal-category pages).
// With `followFilter`, the home-page search script keeps the hrefs in sync
// with the active meal filter (see RecipeSearch.astro).
import { MEAL_LABELS, type Meal } from '../lib/labels';
import { withBase } from '../lib/paths';
import { isBuilderMeal } from '../lib/meal-builder';

interface Props {
  meal?: Meal;
  followFilter?: boolean;
}

const { meal, followFilter = false } = Astro.props;
const randomBase = withBase('random/');
const builderBase = withBase('meal-builder/');
const randomHref = meal ? `${randomBase}?meal=${meal}` : randomBase;
const builderMeal = meal && isBuilderMeal(meal) ? meal : undefined;
const builderHref = builderMeal ? `${builderBase}?meal=${builderMeal}` : builderBase;
---

<div class="quick-actions">
  <a
    class="button"
    href={builderHref}
    data-follow-meal={followFilter ? 'builder' : undefined}
    data-base-href={followFilter ? builderBase : undefined}
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="13" r="7"></circle><circle cx="12" cy="13" r="3"></circle><path d="M3 3v6M5 3v6M4 9v12M21 3c-2 0-3 2-3 5v4h3v9"></path>
    </svg>
    בנה לי ארוחה<span data-meal-suffix>{builderMeal && ` · ${MEAL_LABELS[builderMeal]}`}</span>
  </a>
  <a
    class="button button-secondary"
    href={randomHref}
    data-follow-meal={followFilter ? 'random' : undefined}
    data-base-href={followFilter ? randomBase : undefined}
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="18" height="18" rx="3"></rect><circle cx="8" cy="8" r="1.2" fill="currentColor"></circle><circle cx="16" cy="16" r="1.2" fill="currentColor"></circle><circle cx="12" cy="12" r="1.2" fill="currentColor"></circle>
    </svg>
    מתכון אקראי<span data-meal-suffix>{meal && ` · ${MEAL_LABELS[meal]}`}</span>
  </a>
</div>

<style>
  .quick-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-block-end: 1.25rem;
  }
  .quick-actions .button {
    flex: 1 1 12rem;
  }
  @media (min-width: 48rem) {
    .quick-actions .button {
      flex: 0 0 auto;
    }
  }
</style>
