---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { MEAL_LABELS } from '../lib/labels';
import { recipeUrl } from '../lib/paths';
import { recipeView } from '../lib/recipe';
import StarRating from './StarRating.astro';

interface Props {
  recipe: CollectionEntry<'recipes'>;
}

const { recipe } = Astro.props;
const { title, author } = recipe.data;
const { meal, image, issues, tested, rating } = recipeView(recipe);
---

<article class="card">
  <a class="card-link" href={recipeUrl(recipe.id)}>
    <div class="card-media">
      {
        image ? (
          <Image src={image} alt="" widths={[400, 800]} sizes="(min-width: 48rem) 33vw, 100vw" loading="lazy" />
        ) : (
          <div class="card-placeholder" aria-hidden="true">
            <svg viewBox="0 0 64 64" width="96" height="96">
              <ellipse cx="32" cy="40" rx="26" ry="11" fill="#e8d3b8" />
              <path d="M8 38h48a24 15 0 0 1-48 0z" fill="#c0582f" />
              <path d="M22 26c0-5 4-5 4-10M32 26c0-5 4-5 4-10M42 26c0-5 4-5 4-10" stroke="#c0582f" stroke-width="3" fill="none" stroke-linecap="round" />
            </svg>
          </div>
        )
      }
    </div>
    <div class="card-body">
      <h2 class="card-title">{title}</h2>
      {author && <p class="card-author">מאת {author}</p>}
      <StarRating rating={rating} size="small" />
      {tested && <p class="card-tested">✓ נוסה</p>}
      {issues.length > 0 && <p class="card-fix">צריך לתקן ({issues.length})</p>}
      {
        meal.length > 0 && (
          <ul class="chips" aria-label="ארוחה">
            {meal.map((m) => (
              <li class="chip">{MEAL_LABELS[m]}</li>
            ))}
          </ul>
        )
      }
    </div>
  </a>
</article>

<style>
  .card {
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgb(59 42 32 / 0.14);
  }
  .card-link {
    color: inherit;
    text-decoration: none;
    display: block;
    block-size: 100%;
  }
  .card-media {
    aspect-ratio: 4 / 3;
    background: #f3e2cd;
  }
  .card-media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .card-placeholder {
    display: grid;
    place-items: center;
    block-size: 100%;
  }
  .card-body {
    padding: 0.9rem 1rem 1.1rem;
  }
  .card-title {
    margin: 0 0 0.25rem;
    font-size: 1.25rem;
  }
  .card-author {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .card-tested {
    display: inline-block;
    margin: 0 0 0.5rem 0.4rem;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: #e3f1dc;
    color: #2f5d1f;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .card-fix {
    display: inline-block;
    margin: 0 0 0.5rem;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: #fff4d6;
    border: 1px solid #c98a00;
    color: #6b4a00;
    font-size: 0.85rem;
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
    .card:hover {
      transform: none;
    }
  }
</style>
