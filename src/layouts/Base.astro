---
import '@fontsource-variable/heebo';
import '../styles/global.css';
import { MEALS, MEAL_SHORT_LABELS, SITE_TITLE } from '../lib/labels';
import { mealUrl, withBase } from '../lib/paths';
import { APPS_SCRIPT_URL, FORM_URL, SITE_URL } from '../lib/config';

interface Props {
  title?: string;
  description?: string;
  /** Which nav item is the current page: 'home', a meal key, 'random' or 'meal-builder'. */
  current?: string;
  /** Keep the page out of search engines (e.g. the unlisted "needs fixing" page). */
  noindex?: boolean;
}

const { title, description = 'מתכונים משפחתיים של משפחת שטיינגאוס', current, noindex = false } = Astro.props;
const nav = [
  { key: 'home', label: 'כל המתכונים', href: withBase('/') },
  ...MEALS.map((m) => ({ key: m, label: MEAL_SHORT_LABELS[m], href: mealUrl(m) })),
  { key: 'meal-builder', label: 'בנה לי ארוחה', href: withBase('meal-builder/') },
  { key: 'random', label: 'מתכון אקראי', href: withBase('random/') },
];
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
// "סנכרן עכשיו": the Apps Script web app starts the Drive sync and links back
// (the back link is set to the current page by the script below).
const syncUrl = APPS_SCRIPT_URL ? `${APPS_SCRIPT_URL}?${new URLSearchParams({ action: 'sync', back: SITE_URL })}` : undefined;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#c0582f" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">דלג לתוכן</a>
    <header class="site-header">
      <div class="container">
        <a class="site-title" href={withBase('/')}>{SITE_TITLE}</a>
        <nav class="site-nav" aria-label="ניווט ראשי">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        {
          FORM_URL && (
            <a class="add-recipe" href={FORM_URL} target="_blank" rel="noopener">
              + הוסף מתכון<span class="visually-hidden"> (טופס, נפתח בחלון חדש)</span>
            </a>
          )
        }
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>{SITE_TITLE} · באהבה מהמטבח שלנו</p>
        {
          syncUrl && (
            <p class="footer-actions">
              <a href={syncUrl} data-sync-link>
                סנכרן עכשיו
              </a>
              <span class="footer-hint">מעדכן את האתר מ-Google Drive (כ-3 דקות)</span>
            </p>
          )
        }
      </div>
    </footer>
    <script>
      // Come back to the page the sync was started from.
      for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-sync-link]')) {
        const url = new URL(a.href);
        url.searchParams.set('back', location.href.split('#')[0]);
        a.href = url.href;
      }
    </script>
  </body>
</html>
