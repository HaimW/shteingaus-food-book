---
import Base from '../layouts/Base.astro';
import RecipeGrid from '../components/RecipeGrid.astro';
import RecipeSearch from '../components/RecipeSearch.astro';
import QuickActions from '../components/QuickActions.astro';
import { SITE_TITLE } from '../lib/labels';
import { getSortedRecipes } from '../lib/recipe-index';

const recipes = await getSortedRecipes();
---

<Base current="home">
  <section class="intro">
    <h1>{SITE_TITLE}</h1>
    <p>כל המתכונים של המשפחה במקום אחד.</p>
  </section>

  {
    recipes.length > 0 ? (
      <>
        <QuickActions followFilter />
        <RecipeSearch gridId="recipe-grid" />
        <h2 class="visually-hidden">מתכונים</h2>
        <RecipeGrid recipes={recipes} id="recipe-grid" />
      </>
    ) : (
      <p>עדיין אין מתכונים.</p>
    )
  }
</Base>

<style>
  .intro h1 {
    margin-block: 0 0.25rem;
    font-size: 1.75rem;
  }
  .intro p {
    margin-block: 0 1.25rem;
    color: var(--muted);
  }
  @media (min-width: 60rem) {
    .intro h1 {
      font-size: 2.25rem;
    }
  }
</style>
