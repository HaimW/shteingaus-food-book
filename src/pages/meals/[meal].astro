---
import Base from '../../layouts/Base.astro';
import RecipeGrid from '../../components/RecipeGrid.astro';
import { MEALS, MEAL_LABELS, type Meal } from '../../lib/labels';
import { withBase } from '../../lib/paths';
import { recipeView } from '../../lib/recipe';
import { getSortedRecipes } from '../../lib/recipe-index';

// Meal-category pages: /meals/<meal>/. Only recipes with a known meal value
// are listed (unknown values show up as "צריך לתקן" on the recipe page).
export function getStaticPaths() {
  return MEALS.map((meal) => ({ params: { meal }, props: { meal } }));
}

interface Props {
  meal: Meal;
}

const { meal } = Astro.props;
const label = MEAL_LABELS[meal];
const recipes = (await getSortedRecipes()).filter((r) => recipeView(r).meal.includes(meal));
---

<Base title={label} current={meal} description={`מתכונים ל${label} מספר המתכונים של משפחת שטיינגאוס`}>
  <section class="intro">
    <h1>{label}</h1>
    <p>
      {recipes.length === 1 ? 'מתכון אחד' : `${recipes.length} מתכונים`} ·
      <a href={withBase(`/?meal=${meal}`)}>חיפוש בתוך {label}</a>
    </p>
  </section>

  {recipes.length > 0 ? <RecipeGrid recipes={recipes} /> : <p>עדיין אין מתכונים ל{label}.</p>}
</Base>

<style>
  .intro h1 {
    margin-block: 0 0.25rem;
    font-size: 1.75rem;
  }
  .intro p {
    margin-block: 0 1.5rem;
    color: var(--muted);
  }
  @media (min-width: 60rem) {
    .intro h1 {
      font-size: 2.25rem;
    }
  }
</style>
