---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { MEAL_LABELS, DISH_TYPE_LABELS } from '../../lib/labels';
import { mealUrl, withBase } from '../../lib/paths';
import { recipeView } from '../../lib/recipe';
import { APPS_SCRIPT_URL, SITE_URL } from '../../lib/config';
import StarRating from '../../components/StarRating.astro';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({ params: { slug: recipe.id }, props: { recipe } }));
}

interface Props {
  recipe: CollectionEntry<'recipes'>;
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const { title, servings, prepTime, cookTime, author, tags = [] } = recipe.data;
// R3: missing ingredients, unknown categories or a missing photo never fail the
// build; they are shown as issues on the page instead.
const { meal, dishType, ingredients, image, issues, docUrl, tested, rating } = recipeView(recipe);

// "Tested" toggle and star rating: the Apps Script web app edits the doc's
// "נוסה" / "דירוג" row as the signed-in family member, starts the sync and links back here.
const actionUrl = (action: string, value: string) =>
  APPS_SCRIPT_URL && recipe.data.driveId
    ? `${APPS_SCRIPT_URL}?${new URLSearchParams({
        action,
        doc: recipe.data.driveId,
        value,
        back: new URL(`recipes/${recipe.id}/`, SITE_URL).href,
      })}`
    : undefined;
const toggleUrl = actionUrl('tested', tested ? 'no' : 'yes');
const rateUrls = toggleUrl ? [1, 2, 3, 4, 5].map((n) => actionUrl('rate', String(n))!) : undefined;

const facts = [
  { label: 'מנות', value: servings },
  { label: 'זמן הכנה', value: prepTime },
  { label: 'זמן בישול', value: cookTime },
].filter((f) => f.value);
---

<Base title={title} description={ingredients.length > 0 ? `${title}: ${ingredients.slice(0, 5).join(', ')}` : title}>
  <p class="back"><a href={withBase('/')}><span aria-hidden="true">→</span> לכל המתכונים</a></p>

  <!-- R5: shown only when the page was opened by "מתכון אקראי" (?random=1[&meal=..]). -->
  <div class="random-bar" data-random-bar data-random-base={withBase('random/')} data-slug={recipe.id} hidden>
    <p>בחרנו בשבילך מתכון אקראי<span data-random-meal></span>.</p>
    <a class="button" href={withBase('random/')} data-random-again>עוד מתכון אקראי</a>
  </div>

  <article class="recipe">
    <header class="recipe-header">
      <h1>{title}</h1>
      {author && <p class="author">מאת {author}</p>}
      {
        (meal.length > 0 || dishType.length > 0) && (
          <ul class="chips" aria-label="קטגוריות">
            {meal.map((m) => (
              <li>
                <a class="chip chip-link" href={mealUrl(m)}>
                  {MEAL_LABELS[m]}
                </a>
              </li>
            ))}
            {dishType.map((d) => (
              <li class="chip chip-alt">{DISH_TYPE_LABELS[d]}</li>
            ))}
          </ul>
        )
      }
      <div class="status">
        <p class={tested ? 'tested tested-yes' : 'tested tested-no'}>{tested ? '✓ נוסה' : 'טרם נוסה'}</p>
        <StarRating rating={rating} hrefs={rateUrls} />
      </div>
      {
        (docUrl || toggleUrl) && (
          <div class="recipe-actions">
            {toggleUrl && (
              <a class="button" href={toggleUrl}>
                {tested ? 'סמנו כלא נוסה' : 'סמנו כנוסה ✓'}
              </a>
            )}
            {docUrl && (
              <a class="button button-secondary" href={docUrl} target="_blank" rel="noopener">
                עריכה ב-Google Docs<span class="visually-hidden"> (נפתח בחלון חדש)</span>
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      issues.length > 0 && (
        <aside class="needs-fixing" aria-labelledby="needs-fixing-heading">
          <h2 id="needs-fixing-heading">צריך לתקן</h2>
          <ul>
            {issues.map((issue) => (
              <li>{issue}</li>
            ))}
          </ul>
          {docUrl && (
            <p class="fix-link">
              <a href={docUrl} target="_blank" rel="noopener">
                לתיקון במסמך Google Docs<span class="visually-hidden"> (נפתח בחלון חדש)</span>
              </a>
            </p>
          )}
        </aside>
      )
    }

    {
      image ? (
        <Image
          class="hero"
          src={image}
          alt={title}
          widths={[600, 1000, 1400]}
          sizes="(min-width: 48rem) 48rem, 100vw"
          loading="eager"
        />
      ) : (
        <div class="hero hero-missing">חסרה תמונה</div>
      )
    }

    {
      facts.length > 0 && (
        <dl class="facts">
          {facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class="recipe-layout">
      {
        ingredients.length > 0 ? (
          <section class="ingredients" aria-labelledby="ingredients-heading">
            <h2 id="ingredients-heading">
              מצרכים <span class="count">({ingredients.length})</span>
            </h2>
            <ul>
              {ingredients.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        ) : (
          <section class="ingredients ingredients-missing" aria-labelledby="ingredients-heading">
            <h2 id="ingredients-heading">
              <svg class="warn-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
                <path d="M12 2 1 21h22L12 2z" fill="currentColor" />
                <path d="M11 9h2v6h-2zM11 17h2v2h-2z" fill="#fff" />
              </svg>
              מצרכים חסרים
            </h2>
            <p>למתכון הזה עדיין לא נרשמו מצרכים.</p>
            <p class="hint">כדי לתקן: מוסיפים את רשימת המצרכים (כמות + מצרך בכל שורה) במסמך המתכון.</p>
          </section>
        )
      }

      <div class="recipe-body">
        <Content />
        {
          tags.length > 0 && (
            <ul class="chips tags" aria-label="תגיות">
              {tags.map((t) => (
                <li>
                  <a class="chip chip-tag" href={withBase(`/?q=${encodeURIComponent(t)}`)}>
                    #{t}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </article>
</Base>

<script>
  import { MEAL_LABELS } from '../../lib/labels';
  import { parseRandomlyOpened, randomSearch } from '../../lib/random';

  const bar = document.querySelector<HTMLElement>('[data-random-bar]');
  const { random, meal } = parseRandomlyOpened(location.search);
  if (bar && random) {
    bar.querySelector('[data-random-meal]')!.textContent = meal ? ` מתוך ${MEAL_LABELS[meal]}` : '';
    bar.querySelector<HTMLAnchorElement>('[data-random-again]')!.href =
      `${bar.dataset.randomBase}${randomSearch({ meal, not: bar.dataset.slug })}`;
    bar.hidden = false;
  }
</script>

<style>
  .random-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-block-end: 1rem;
    padding: 0.75rem 1rem;
    border: 2px dashed var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .random-bar p {
    margin: 0;
    font-weight: 600;
  }
  .back {
    margin-block: 0 1rem;
  }
  .recipe {
    max-inline-size: 48rem;
  }
  .chip-link,
  .chip-tag {
    display: inline-block;
    text-decoration: none;
  }
  .chip-link:hover,
  .chip-tag:hover {
    text-decoration: underline;
  }
  .chip-tag {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted);
  }
  .recipe-body .tags {
    margin-block-start: 2rem;
    padding: 0;
  }
  .recipe-body .tags li + li {
    margin: 0;
  }
  .recipe-header h1 {
    margin-block: 0 0.25rem;
    font-size: 1.9rem;
  }
  .author {
    margin-block: 0 0.6rem;
    color: var(--muted);
  }
  .chip-alt {
    background: #e7efdc;
    color: #4a6130;
  }
  .hero {
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    margin-block: 1.25rem;
    box-shadow: var(--shadow);
  }
  .hero.hero-missing {
    aspect-ratio: 3 / 1;
    display: grid;
    place-items: center;
    background: var(--danger-bg);
    border: 2px dashed var(--danger);
    color: var(--danger);
    font-weight: 600;
    box-shadow: none;
  }
  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-block-start: 0.5rem;
  }
  .tested {
    display: inline-block;
    margin: 0;
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .tested-yes {
    background: #e3f1dc;
    color: #2f5d1f;
  }
  .tested-no {
    background: #eee8e2;
    color: var(--muted);
  }
  .recipe-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 0.75rem;
  }
  .needs-fixing {
    background: #fff4d6;
    border: 2px solid #c98a00;
    color: #6b4a00;
    border-radius: var(--radius);
    padding: 0.75rem 1.25rem;
    margin-block: 1rem;
  }
  .needs-fixing h2 {
    margin-block: 0 0.25rem;
    font-size: 1.1rem;
  }
  .needs-fixing .fix-link {
    margin-block: 0.5rem 0;
    font-weight: 600;
  }
  .needs-fixing .fix-link a {
    color: inherit;
  }
  .needs-fixing ul {
    margin: 0;
    padding-inline-start: 1.25rem;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block: 1rem;
  }
  .facts > div {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 0.4rem 0.9rem;
    min-inline-size: 7rem;
  }
  .facts dt {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    font-weight: 600;
  }
  .ingredients {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    margin-block: 1.5rem;
  }
  .ingredients h2 {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-block: 0 0.5rem;
  }
  .ingredients .count {
    color: var(--muted);
    font-size: 1rem;
    font-weight: 500;
  }
  .ingredients ul {
    margin: 0;
    padding-inline-start: 1.25rem;
  }
  .ingredients li + li {
    margin-block-start: 0.25rem;
  }
  .ingredients li::marker {
    color: var(--accent);
  }
  .ingredients-missing {
    background: var(--danger-bg);
    border: 2px solid var(--danger);
    color: var(--danger);
  }
  .ingredients-missing p {
    margin: 0;
    font-weight: 600;
  }
  .ingredients-missing .hint {
    margin-block-start: 0.35rem;
    font-weight: 400;
    color: var(--text);
  }
  .warn-icon {
    flex: none;
  }
  .recipe-body :global(h2) {
    margin-block: 1.75rem 0.5rem;
  }
  .recipe-body :global(ol),
  .recipe-body :global(ul) {
    padding-inline-start: 1.5rem;
  }
  /* Extra photos from the Google Doc, shown where they were pasted. */
  .recipe-body :global(img) {
    display: block;
    block-size: auto;
    border-radius: var(--radius);
    margin-block: 1rem;
  }
  .recipe-body :global(li + li) {
    margin-block-start: 0.4rem;
  }
  @media (min-width: 48rem) {
    .recipe-header h1 {
      font-size: 2.5rem;
    }
  }
  /* Desktop: ingredients beside the steps (start side = right in RTL). */
  @media (min-width: 64rem) {
    .recipe {
      max-inline-size: 64rem;
    }
    .recipe > :global(img.hero) {
      aspect-ratio: 16 / 9;
    }
    .recipe-layout {
      display: grid;
      grid-template-columns: 20rem 1fr;
      gap: 2rem;
      align-items: start;
    }
    .ingredients {
      position: sticky;
      inset-block-start: 1rem;
      margin-block: 1.75rem 0;
    }
  }
</style>
