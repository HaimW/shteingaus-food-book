---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { MEAL_LABELS, DISH_TYPE_LABELS } from '../../lib/labels';
import { withBase } from '../../lib/paths';
import { recipeView } from '../../lib/recipe';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({ params: { slug: recipe.id }, props: { recipe } }));
}

interface Props {
  recipe: CollectionEntry<'recipes'>;
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const { title, servings, prepTime, cookTime, author } = recipe.data;
// R3: missing ingredients, unknown categories or a missing photo never fail the
// build; they are shown as issues on the page instead.
const { meal, dishType, ingredients, image, issues } = recipeView(recipe);

const facts = [
  { label: 'מנות', value: servings },
  { label: 'זמן הכנה', value: prepTime },
  { label: 'זמן בישול', value: cookTime },
].filter((f) => f.value);
---

<Base title={title}>
  <p class="back"><a href={withBase('/')}><span aria-hidden="true">→</span> לכל המתכונים</a></p>

  <article class="recipe">
    <header class="recipe-header">
      <h1>{title}</h1>
      {author && <p class="author">מאת {author}</p>}
      {
        (meal.length > 0 || dishType.length > 0) && (
          <ul class="chips" aria-label="קטגוריות">
            {meal.map((m) => (
              <li class="chip">{MEAL_LABELS[m]}</li>
            ))}
            {dishType.map((d) => (
              <li class="chip chip-alt">{DISH_TYPE_LABELS[d]}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      issues.length > 0 && (
        <aside class="needs-fixing" aria-labelledby="needs-fixing-heading">
          <h2 id="needs-fixing-heading">צריך לתקן</h2>
          <ul>
            {issues.map((issue) => (
              <li>{issue}</li>
            ))}
          </ul>
        </aside>
      )
    }

    {
      image ? (
        <Image
          class="hero"
          src={image}
          alt={title}
          widths={[600, 1000, 1400]}
          sizes="(min-width: 48rem) 48rem, 100vw"
          loading="eager"
        />
      ) : (
        <div class="hero hero-missing">חסרה תמונה</div>
      )
    }

    {
      facts.length > 0 && (
        <dl class="facts">
          {facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      ingredients.length > 0 ? (
        <section class="ingredients" aria-labelledby="ingredients-heading">
          <h2 id="ingredients-heading">מצרכים</h2>
          <ul>
            {ingredients.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ) : (
        <section class="ingredients ingredients-missing" aria-labelledby="ingredients-heading">
          <h2 id="ingredients-heading">מצרכים חסרים</h2>
          <p>למתכון הזה עדיין לא נרשמו מצרכים.</p>
        </section>
      )
    }

    <div class="recipe-body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back {
    margin-block: 0 1rem;
  }
  .recipe {
    max-inline-size: 48rem;
  }
  .recipe-header h1 {
    margin-block: 0 0.25rem;
    font-size: 1.9rem;
  }
  .author {
    margin-block: 0 0.6rem;
    color: var(--muted);
  }
  .chip-alt {
    background: #e7efdc;
    color: #4a6130;
  }
  .hero {
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    margin-block: 1.25rem;
    box-shadow: var(--shadow);
  }
  .hero-missing {
    display: grid;
    place-items: center;
    background: var(--danger-bg);
    border: 2px dashed var(--danger);
    color: var(--danger);
    font-weight: 600;
    box-shadow: none;
  }
  .needs-fixing {
    background: #fff4d6;
    border: 2px solid #c98a00;
    color: #6b4a00;
    border-radius: var(--radius);
    padding: 0.75rem 1.25rem;
    margin-block: 1rem;
  }
  .needs-fixing h2 {
    margin-block: 0 0.25rem;
    font-size: 1.1rem;
  }
  .needs-fixing ul {
    margin: 0;
    padding-inline-start: 1.25rem;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-block: 1rem;
  }
  .facts dt {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    font-weight: 600;
  }
  .ingredients {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    margin-block: 1.5rem;
  }
  .ingredients h2 {
    margin-block: 0 0.5rem;
  }
  .ingredients ul {
    margin: 0;
    padding-inline-start: 1.25rem;
  }
  .ingredients li + li {
    margin-block-start: 0.25rem;
  }
  .ingredients-missing {
    background: var(--danger-bg);
    border: 2px solid var(--danger);
    color: var(--danger);
  }
  .ingredients-missing p {
    margin: 0;
  }
  .recipe-body :global(h2) {
    margin-block: 1.75rem 0.5rem;
  }
  .recipe-body :global(ol),
  .recipe-body :global(ul) {
    padding-inline-start: 1.5rem;
  }
  .recipe-body :global(li + li) {
    margin-block-start: 0.4rem;
  }
  @media (min-width: 48rem) {
    .recipe-header h1 {
      font-size: 2.5rem;
    }
  }
</style>
